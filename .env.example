MYSQL_ROOT_PASSWORD=change-this-local-password
# For local development, update the matching password in mysql/init/01-service-databases.sql too.
DB_SERVICE_PASSWORD=apex-service-dev-password
MYSQL_HOST=localhost
MYSQL_PORT=3306
GATEWAY_PORT=4100
KAFKA_BROKERS=localhost:29092
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
TWELVE_DATA_API_KEY=
MARKET_REFRESH_MS=900000
PROVIDER_REQUEST_DELAY_MS=500
PAPER_INITIAL_CASH=100000